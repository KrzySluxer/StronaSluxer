# Moduły Sluxer na home.pl
# Pozwala WordPressowi na innej domenie wczytywać pliki modułów (historia.json, skrypty, klatki).
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>

# Pliki z treścią i kod sprawdzane przy każdym wejściu, żeby zmiany było widać od razu;
# klatki animacji (WebP) trzymane w pamięci przeglądarki przez tydzień.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 7 days"
</IfModule>

AddType image/webp .webp
AddType text/javascript .js
AddType application/json .json
